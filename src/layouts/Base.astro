---
import '../styles/clay.css';
import site from '../data/site.json';
import menu from '../data/menu.json';
import { buildRestaurantSchema } from '../lib/menu.js';

const { title, description } = Astro.props;
const pageTitle = title ?? `${site.name}, ${site.tagline.charAt(0).toLowerCase()}${site.tagline.slice(1)}`;
const pageDesc = description ?? site.description;
const jsonLd = buildRestaurantSchema(site, menu);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.jpeg" />

    <!-- Open Graph / partage Facebook -->
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content="/logo.jpeg" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Données structurées pour le référencement local -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
