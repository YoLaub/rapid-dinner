---
import { formatPrice } from '../lib/menu.js';
import { buildCatalog } from '../lib/cart.js';
import Plus from './icons/Plus.astro';

const { category } = Astro.props;
const featured = category.featured ? ' section-featured' : '';

// Every item has a price, so catalog entries line up with category.items by position.
const keys = Object.values(buildCatalog([category])).map((entry) => entry.key);
---

<section id={category.id} class="menu-section">
  <article class={`clay-card${featured}`}>
    <h2>{category.name}</h2>
    {category.note && <p class="section-note">{category.note}</p>}

    <div class="items">
      {
        category.items.map((item, index) => {
          const prices = item.priceFrites
            ? [
                { label: 'Seul', amount: item.price },
                { label: 'Avec frites', amount: item.priceFrites },
              ]
            : [{ label: undefined, amount: item.price }];
          return (
            <div class="item">
              <span class="item-name">{item.name}</span>
              {item.description && <span class="item-desc">{item.description}</span>}
              <div class="item-actions">
                {prices.map((price) => (
                  <button
                    type="button"
                    class="add-btn"
                    data-add
                    data-item-key={keys[index]}
                    data-variant={price.label}
                    aria-label={`Ajouter ${item.name}${price.label ? `, ${price.label}` : ''}, ${formatPrice(price.amount)}`}
                  >
                    {price.label && <span class="add-label">{price.label}</span>}
                    <span class="add-price">{formatPrice(price.amount)}</span>
                    <Plus class="icon" />
                  </button>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </article>
</section>
