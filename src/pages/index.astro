---
import Base from '../layouts/Base.astro';
import MenuCategory from '../components/MenuCategory.astro';
import site from '../data/site.json';
import menu from '../data/menu.json';
import OpenStatusBadge from '../components/OpenStatusBadge.astro';
import GoogleReviewsLink from '../components/GoogleReviewsLink.astro';
import Cart from '../components/Cart.astro';
import { buildCatalog } from '../lib/cart.js';

const mapsQuery = encodeURIComponent(
  `${site.name} ${site.address.street} ${site.address.postalCode} ${site.address.city}`
);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const telUrl = `tel:${site.phoneHref}`;
const catalog = buildCatalog(menu.categories);
---

<Base>
  <!-- En-tête collant -->
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="#top">
        <span>Rapid'Dinner</span>
      </a>
      <a class="btn btn-red header-call" href={telUrl}>📞 Appeler</a>
    </div>
  </header>

  <main class="wrap" id="top">
    <!-- Hero -->
    <section class="hero">
      <img class="logo-hero" src="/logo.jpeg" alt="Rapid'Dinner — burgers, frites, kebab" />
      <h1>Rapid'Dinner</h1>
      <p class="tagline">{site.tagline} · Sur place ou à emporter</p>

      <div class="hero-actions">
        <a class="btn btn-red" href="#formules">🍔 Voir la carte</a>
        <a class="btn btn-gold" href={telUrl}>📞 {site.phone}</a>
        <a class="btn btn-cream" href={mapsUrl} target="_blank" rel="noopener">📍 Itinéraire</a>
      </div>

      <div class="hero-status">
        <OpenStatusBadge />
        <GoogleReviewsLink />
      </div>

      <div class="hero-facts">
        <span class="clay-pill">📍 {site.address.street}, {site.address.city}</span>
        <span class="clay-pill">🕑 Mar–Sam · midi &amp; soir</span>
        <span class="clay-pill">🥙 Kebab halal · 🍔 Burgers maison</span>
      </div>
    </section>

    <!-- Navigation des catégories -->
    <nav class="cat-nav" aria-label="Catégories de la carte">
      <div class="row">
        <button type="button" class="cat-arrow" data-cat-prev aria-label="Catégories précédentes">‹</button>
        <div class="scroller" data-cat-scroller>
          {menu.categories.map((c) => (
            <a class="clay-pill" href={`#${c.id}`}>{c.icon} {c.name.replace(/^Les?\s+/i, '')}</a>
          ))}
        </div>
        <button type="button" class="cat-arrow" data-cat-next aria-label="Catégories suivantes">›</button>
      </div>
    </nav>

    <!-- La carte -->
    {menu.categories.map((category) => <MenuCategory category={category} />)}

    <!-- Bandeau sauces -->
    <section class="menu-section">
      <article class="clay-card sauces">
        <h3>🌶️ Les sauces au choix</h3>
        <div class="tags">
          {menu.sauces.map((s) => <span class="tag">{s}</span>)}
        </div>
      </article>
    </section>

    <!-- Infos pratiques -->
    <section id="infos" class="menu-section">
      <article class="clay-card">
        <h2>📌 Infos pratiques</h2>
        <div class="infos-grid">
          <div class="info-block">
            <h3>Horaires</h3>
            <ul class="hours">
              {site.hours.map((h) => (
                <li>
                  <span class="days">{h.days}</span>
                  <span class="slots">{h.slots.join(' · ')}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="info-block">
            <h3>Nous trouver</h3>
            <p class="address">
              {site.address.street}<br />
              {site.address.postalCode} {site.address.city}
            </p>
            <div class="hero-actions" style="justify-content:flex-start;">
              <a class="btn btn-red" href={telUrl}>📞 Appeler</a>
              <a class="btn btn-cream" href={mapsUrl} target="_blank" rel="noopener">📍 Itinéraire</a>
              <a class="btn btn-cream" href={site.facebook} target="_blank" rel="noopener">📘 Facebook</a>
            </div>
          </div>
        </div>
      </article>
    </section>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="wrap">
      <strong>Rapid'Dinner</strong> — {site.address.street}, {site.address.postalCode} {site.address.city}
      <br />
      Tél. <a href={telUrl}>{site.phone}</a> ·
      <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
      <p class="legal-note">{site.alcoholNotice}</p>
      <p class="legal-note">
        Prix TTC. Tarifs Avril 2026, sous réserve de modification.
        Photos et carte fournies par le restaurant.
      </p>
    </div>
  </footer>

  <Cart {catalog} />

  <script>
    // Flèches de défilement horizontal de la nav des catégories.
    const scroller = document.querySelector('[data-cat-scroller]');
    const prev = document.querySelector('[data-cat-prev]');
    const next = document.querySelector('[data-cat-next]');
    if (scroller && prev && next) {
      const step = () => Math.max(160, scroller.clientWidth * 0.75);
      const sync = () => {
        const max = scroller.scrollWidth - scroller.clientWidth - 1;
        prev.toggleAttribute('disabled', scroller.scrollLeft <= 0);
        next.toggleAttribute('disabled', scroller.scrollLeft >= max);
      };
      prev.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
      scroller.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }
  </script>
</Base>
